rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerEmail() {
      return isSignedIn() ? request.auth.token.email.lower() : '';
    }

    // Platform admin is resolved ONLY from the platformUsers document.
    // No email allowlists. No client-settable flags.
    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.platformRole == 'platform_admin';
    }

    function societyDoc(societyId) {
      return get(/databases/$(database)/documents/societies/$(societyId));
    }

    function societyIsUsable(societyId) {
      return societyDoc(societyId).data.status != 'suspended'
        && societyDoc(societyId).data.status != 'archived';
    }

    function memberDoc(societyId) {
      return get(/databases/$(database)/documents/societies/$(societyId)/members/$(request.auth.uid));
    }

    // Active membership record (society itself may be suspended —
    // used for reading society status so the UI can show "suspended").
    function hasActiveMembership(societyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/societies/$(societyId)/members/$(request.auth.uid))
        && memberDoc(societyId).data.status == 'active';
    }

    // Active membership in a usable society (operational access).
    // Platform admins are included so a newly created society (which has
    // no members yet) can be bootstrapped: towers, flats and the first
    // admin invitation cannot be created without read access.
    function isSocietyMember(societyId) {
      return isPlatformAdmin()
        || (hasActiveMembership(societyId) && societyIsUsable(societyId));
    }

    function societyRole(societyId) {
      return memberDoc(societyId).data.role;
    }

    function isSocietyAdmin(societyId) {
      return isSocietyMember(societyId)
        && (societyRole(societyId) == 'society_admin' || societyRole(societyId) == 'admin');
    }

    function isSecurityGuard(societyId) {
      return isSocietyAdmin(societyId)
        || (isSocietyMember(societyId) && societyRole(societyId) == 'security');
    }

    // ---------- Platform Users (global identity index) ----------
    // Owner may update ONLY safe profile fields. platformRole and
    // societyIds are never client-writable (bootstrap / invite flows only).
    match /platformUsers/{userId} {
      allow get: if isOwner(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.platformRole == null
        && (!('societyIds' in request.resource.data) || request.resource.data.societyIds.size() == 0);
      allow update: if (isOwner(userId)
        && request.resource.data.platformRole == resource.data.platformRole
        && request.resource.data.societyIds == resource.data.societyIds)
        || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ---------- Society Invites (code is the document ID) ----------
    match /societyInvites/{code} {
      // Single-invite lookup for acceptance; codes are high-entropy secrets.
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      // Platform admins and society admins of the target society mint invites.
      allow create: if isPlatformAdmin()
        || (isSignedIn() && isSocietyAdmin(request.resource.data.societyId));
      // Accept: only the invited email holder, only pending->accepted.
      // Revoke/expire: platform admin.
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && resource.data.email == callerEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt']));
      allow delete: if isPlatformAdmin();
    }

    // ---------- Societies ----------
    match /societies/{societyId} {
      // Members can always read their society doc (needed to display
      // "suspended" state). Public directory for join-by-search.
      allow get: if isPlatformAdmin()
        || hasActiveMembership(societyId)
        || (isSignedIn() && resource.data.status in ['active', 'onboarding']);
      allow list: if isPlatformAdmin()
        || (isSignedIn() && resource.data.status in ['active', 'onboarding']);
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || isSocietyAdmin(societyId);
      allow delete: if isPlatformAdmin();

      match /towers/{towerId} {
        allow read: if isSocietyMember(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /flats/{flatId} {
        allow read: if isSocietyMember(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /members/{memberId} {
        allow read: if isSocietyMember(societyId);
        // Self join-request (pending) or invite acceptance (active).
        // Invite codes are high-entropy single-use secrets validated
        // client-side (email match + expiry + status) and audited.
        allow create: if isOwner(memberId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status in ['pending', 'active']
          && request.resource.data.role in ['resident', 'security', 'committee', 'society_admin'];
        // Self safe-field edits, or full management by society admin.
        allow update: if isSocietyAdmin(societyId)
          || (isOwner(memberId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);
        allow delete: if isSocietyAdmin(societyId);
      }

      match /visitors/{visitorId} {
        allow read: if isSocietyMember(societyId);
        allow create: if isSocietyMember(societyId);
        allow update: if isSocietyMember(societyId) || isSecurityGuard(societyId);
        allow delete: if isSocietyAdmin(societyId);
      }

      match /complaints/{complaintId} {
        allow read: if isSocietyMember(societyId);
        allow create: if isSocietyMember(societyId);
        allow update: if isSocietyMember(societyId);
        allow delete: if isSocietyAdmin(societyId);
      }

      match /bills/{billId} {
        allow read: if isSocietyMember(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      // Payments: members may initiate a pending UTR claim; only society
      // admins may verify or reject — enforced below.
      match /payments/{paymentId} {
        allow read: if isSocietyMember(societyId);
        allow create: if isSocietyMember(societyId)
          && request.resource.data.status == 'PENDING_VERIFICATION'
          && request.resource.data.paymentMethod == 'UPI';
        allow update: if isSocietyAdmin(societyId)
          && (request.resource.data.status == 'VERIFIED' || request.resource.data.status == 'REJECTED');
        // Delete allowed for admins (society wipe only).
        allow delete: if isSocietyAdmin(societyId);
      }

      match /facilities/{facilityId} {
        allow read: if isSocietyMember(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /facilityBookings/{bookingId} {
        allow read: if isSocietyMember(societyId);
        allow create, update: if isSocietyMember(societyId);
        allow delete: if isSocietyAdmin(societyId);
      }

      match /notices/{noticeId} {
        allow read: if isSocietyMember(societyId);
        allow write: if isSocietyAdmin(societyId);
      }

      match /elections/{electionId} {
        allow read: if isSocietyMember(societyId);
        allow create, delete: if isSocietyAdmin(societyId);
        // Members may bump counters only when casting a vote
        // (duplicate protection via deterministic vote doc IDs).
        allow update: if isSocietyAdmin(societyId)
          || (isSocietyMember(societyId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotesCast', 'updatedAt']));

        match /nominations/{nominationId} {
          allow read: if isSocietyMember(societyId);
          allow create: if isSocietyMember(societyId);
          allow update: if isSocietyAdmin(societyId)
            || (isSocietyMember(societyId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount', 'updatedAt']));
          allow delete: if isSocietyAdmin(societyId);
        }

        match /votes/{voteId} {
          allow read: if isSocietyMember(societyId);
          // One vote per voter enforced by deterministic doc ID.
          allow create: if isSocietyMember(societyId);
          allow update: if false;
          // Platform admin only (society wipe). Ballots are otherwise immutable.
          allow delete: if isPlatformAdmin();
        }
      }

      match /auditLogs/{logId} {
        allow read: if isSocietyAdmin(societyId);
        allow create: if isSignedIn();
        allow update: if false;
        // Platform admin only (society wipe). Audit trail is otherwise immutable.
        allow delete: if isPlatformAdmin();
      }

      match /treasury/{txId} {
        allow read: if isSocietyAdmin(societyId);
        allow create: if isSocietyAdmin(societyId);
        allow update, delete: if false;  // Never delete financial records
      }

      match /notifications/{notificationId} {
        allow read: if request.auth.uid == resource.data.userId;
        allow create: if isSocietyAdmin(societyId);
        allow update: if request.auth.uid == resource.data.userId;
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if isSocietyAdmin(societyId);
        allow create: if isSocietyAdmin(societyId);
        allow update: if isSocietyAdmin(societyId);  // for cancellation
        allow delete: if false;
      }

      match /treasury/{txId} {
        allow read: if isSocietyAdmin(societyId);
        allow create: if isSocietyAdmin(societyId);
        allow update: if false;
        allow delete: if false;
      }
    }

    // ---------- Platform Analytics (derived, backend-written) ----------
    match /platformAnalytics/{societyId} {
      allow read: if isPlatformAdmin() || isSocietyAdmin(societyId);
      allow update: if false;
      // Platform admin only (society wipe).
      allow delete: if isPlatformAdmin();
      allow create: if false;
    }

    // ---------- Support Sessions ----------
    match /supportSessions/{sessionId} {
      allow read, write: if isPlatformAdmin();
    }

    // ---------- Platform Audit ----------
    match /platformAuditLogs/{logId} {
      allow read, write: if isPlatformAdmin();
    }

    // ---------- Default deny ----------
    // NOTE: Firestore Security Rules cannot enforce rate limiting.
    // When Blaze billing is enabled, add Cloud Functions or App Check
    // with rate limiting to prevent abuse (e.g., payment claim spam,
    // brute-force invite code guessing, excessive complaint creation).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
