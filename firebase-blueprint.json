{
  "entities": {
    "PlatformUser": {
      "title": "PlatformUser",
      "description": "Global user identity document and society associations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "platformRole": { "type": "string", "enum": ["platform_admin", null] },
        "societyIds": { "type": "array" },
        "currentSocietyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "Society": {
      "title": "Society",
      "description": "Tenant organization representing a gated society or residential complex",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending_admin", "onboarding", "active", "suspended", "archived"] },
        "timezone": { "type": "string" },
        "currency": { "type": "string" },
        "features": { "type": "object" },
        "registeredNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "activatedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "city", "status"]
    },
    "Tower": {
      "title": "Tower",
      "description": "Building or block within a society",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "floors": { "type": "integer" },
        "totalFlats": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "maintenance"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "Flat": {
      "title": "Flat",
      "description": "First-class residential unit or apartment within a society",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "number": { "type": "string" },
        "towerId": { "type": "string" },
        "floor": { "type": "integer" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "vacant", "blocked"] },
        "ownerIds": { "type": "array" },
        "tenantIds": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "number", "towerId", "status"]
    },
    "SocietyMember": {
      "title": "SocietyMember",
      "description": "Authoritative membership linking a user account to a society with their verified role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "societyId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["society_admin", "committee", "security", "resident"] },
        "status": { "type": "string", "enum": ["pending", "active", "suspended", "removed"] },
        "flatId": { "type": "string" },
        "flatNumber": { "type": "string" },
        "towerName": { "type": "string" },
        "designation": { "type": "string" },
        "profileComplete": { "type": "boolean" },
        "joinedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "uid", "name", "email", "role", "status"]
    },
    "SocietyInvite": {
      "title": "SocietyInvite",
      "description": "Invitation to join a society with a pre-assigned role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "email": { "type": "string" },
        "intendedRole": { "type": "string", "enum": ["society_admin", "committee", "security", "resident"] },
        "flatId": { "type": "string" },
        "tokenHash": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "revoked", "expired"] },
        "expiresAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "acceptedBy": { "type": "string" },
        "acceptedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "societyId", "email", "intendedRole", "status"]
    },
    "Visitor": {
      "title": "Visitor",
      "description": "Visitor entry authorization and tracking log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "residentId": { "type": "string" },
        "flatId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "flat": { "type": "string" },
        "tower": { "type": "string" },
        "residentName": { "type": "string" },
        "purpose": { "type": "string" },
        "type": { "type": "string", "enum": ["Guest", "Delivery", "Service", "Cab"] },
        "passNumber": { "type": "string" },
        "qrCode": { "type": "string" },
        "status": { "type": "string", "enum": ["expected", "waiting", "inside", "exited", "rejected"] },
        "approvalStatus": { "type": "string" },
        "expectedDate": { "type": "string" },
        "expectedTime": { "type": "string" },
        "entryTime": { "type": "string" },
        "exitTime": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "gateNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "flat", "passNumber", "status"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Resident maintenance complaint or issue ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "flat": { "type": "string" },
        "tower": { "type": "string" },
        "residentName": { "type": "string" },
        "residentPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["reported", "assigned", "started", "resolved"] },
        "priority": { "type": "string", "enum": ["Normal", "High", "Urgent"] },
        "reportedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "ticketNumber", "title", "category", "status", "priority"]
    },
    "MaintenanceBill": {
      "title": "MaintenanceBill",
      "description": "Monthly society maintenance bill and payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "billNumber": { "type": "string" },
        "flat": { "type": "string" },
        "tower": { "type": "string" },
        "residentName": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "integer" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Paid", "Pending", "Overdue"] },
        "dueDate": { "type": "string" },
        "paidAt": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "billNumber", "flat", "totalAmount", "status", "dueDate"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Server-confirmed payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "billId": { "type": "string" },
        "flatId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "provider": { "type": "string" },
        "providerTransactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "failed", "refunded"] },
        "initiatedAt": { "type": "string" },
        "confirmedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "billId", "amount", "status"]
    },
    "Facility": {
      "title": "Facility",
      "description": "Society common facility or amenity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "capacity": { "type": "integer" },
        "pricePerHour": { "type": "number" },
        "timings": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "name", "capacity"]
    },
    "FacilityBooking": {
      "title": "FacilityBooking",
      "description": "Amenity booking reservation by a resident",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "facilityId": { "type": "string" },
        "facilityName": { "type": "string" },
        "flat": { "type": "string" },
        "residentName": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "totalCost": { "type": "number" },
        "status": { "type": "string", "enum": ["Confirmed", "Completed", "Cancelled"] },
        "bookedAt": { "type": "string" }
      },
      "required": ["id", "facilityId", "flat", "date", "timeSlot", "status"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Official RWA announcement or broadcast notice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "audience": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "publishedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "message", "priority"]
    },
    "Election": {
      "title": "Election",
      "description": "Society Management Committee election instance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "title": { "type": "string" },
        "term": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Nomination Open", "Voting Active", "Completed"] },
        "totalVotesCast": { "type": "integer" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "term", "status"]
    },
    "Nomination": {
      "title": "Nomination",
      "description": "Candidate nomination for an elected post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "electionId": { "type": "string" },
        "position": { "type": "string" },
        "candidateName": { "type": "string" },
        "flat": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "electionId", "position", "candidateName", "status"]
    },
    "Vote": {
      "title": "Vote",
      "description": "Ballot cast by a verified resident for a committee position",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "electionId": { "type": "string" },
        "position": { "type": "string" },
        "candidateId": { "type": "string" },
        "voterId": { "type": "string" },
        "voterFlat": { "type": "string" },
        "castAt": { "type": "string" }
      },
      "required": ["id", "electionId", "position", "candidateId", "voterId"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and administrative action audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "societyId": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "actorId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/platformUsers/{userId}": {
      "schema": "PlatformUser",
      "description": "Global user identity document and society indices"
    },
    "/societies/{societyId}": {
      "schema": "Society",
      "description": "Isolated society tenant document"
    },
    "/societyInvites/{inviteId}": {
      "schema": "SocietyInvite",
      "description": "Society joining invitations"
    },
    "/societies/{societyId}/towers/{towerId}": {
      "schema": "Tower",
      "description": "Towers and blocks within a society"
    },
    "/societies/{societyId}/flats/{flatId}": {
      "schema": "Flat",
      "description": "First-class residential flat records"
    },
    "/societies/{societyId}/members/{memberId}": {
      "schema": "SocietyMember",
      "description": "Authoritative society membership mapping with assigned roles"
    },
    "/societies/{societyId}/visitors/{visitorId}": {
      "schema": "Visitor",
      "description": "Visitor logs and gate passes"
    },
    "/societies/{societyId}/complaints/{complaintId}": {
      "schema": "Complaint",
      "description": "Maintenance tickets and complaints"
    },
    "/societies/{societyId}/bills/{billId}": {
      "schema": "MaintenanceBill",
      "description": "Maintenance dues and billing records"
    },
    "/societies/{societyId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Confirmed payments and receipts"
    },
    "/societies/{societyId}/facilities/{facilityId}": {
      "schema": "Facility",
      "description": "Common facilities and amenities"
    },
    "/societies/{societyId}/facilityBookings/{bookingId}": {
      "schema": "FacilityBooking",
      "description": "Amenity bookings"
    },
    "/societies/{societyId}/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Society broadcast notices"
    },
    "/societies/{societyId}/elections/{electionId}": {
      "schema": "Election",
      "description": "Committee election ballots"
    },
    "/societies/{societyId}/elections/{electionId}/nominations/{nominationId}": {
      "schema": "Nomination",
      "description": "Election nominee profiles"
    },
    "/societies/{societyId}/elections/{electionId}/votes/{voteId}": {
      "schema": "Vote",
      "description": "Cast election votes"
    },
    "/societies/{societyId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative audit trail"
    }
  }
}
